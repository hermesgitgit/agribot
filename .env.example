# agribot 環境變數範本（2026-11-02 審查修正新增）
# 複製成 .env 後填值；值一律留空在此、真正的金鑰絕不進版控。

# ---- 必填（缺一則 config.py 啟動即退出）----
GEMINI_API_KEY=            # Google AI Studio 金鑰，主模型 Gemini 用
AGRI_API_KEY=              # 阿龜物聯網 API 金鑰
AGRI_SUID=                 # 阿龜物聯網感測站 SUID
TELEGRAM_TOKEN=            # Telegram bot token（BotFather 發的）
TELEGRAM_CHAT_ID=          # 擁有者的 Telegram chat id，只有這個對話會被回應

# ---- 選填 ----
NVIDIA_API_KEY=            # 報告備援模型金鑰（Gemini 壅塞耗盡時改打 NVIDIA），未設則不備援
NVIDIA_MODEL=              # 備援模型 ID，未設用程式內預設值
CWA_API_KEY=               # 中央氣象署開放資料授權碼（文山站觀測、警特報；未設則略過）
AGRI_USERNAME=             # 阿龜平台網頁登入帳號（爬蟲用）
AGRI_PASSWORD=             # 阿龜平台網頁登入密碼（爬蟲用）
HEARTBEAT_URL=             # 外部死人開關 ping 網址（如 healthchecks.io），未設則跳過
BRIDGE_SHARED_SECRET=      # Hermes 橋接端點共用密鑰，未設則端點停用
BRIDGE_PORT=               # 橋接端點埠號，未設預設 8765
